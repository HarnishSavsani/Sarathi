# ============================================================
# Sarathi — .gitignore
# Next.js 16 · Electron · SQLite · Node.js monorepo
# ============================================================

# ────────────────────────────────────────────────
# 1. Dependencies
# ────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ────────────────────────────────────────────────
# 2. Build outputs — Next.js
# ────────────────────────────────────────────────
.next/
out/
dist/
.build/
.source/

# Next.js auto-generated type declarations (regenerated on build)
next-env.d.ts

# ────────────────────────────────────────────────
# 3. Build outputs — Electron
# ────────────────────────────────────────────────
electron/dist/
electron/out/
electron/.webpack/

# ────────────────────────────────────────────────
# 4. Build outputs — packages / open-sse
# ────────────────────────────────────────────────
packages/*/dist/
packages/*/build/
open-sse/dist/
@sarathi/dist/

# ────────────────────────────────────────────────
# 5. Environment & secrets
# ────────────────────────────────────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
.env.*.local
# Keep the example template
!.env.example

# ────────────────────────────────────────────────
# 6. Database files (SQLite / WAL)
# ────────────────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
data/

# ────────────────────────────────────────────────
# 7. Logs
# ────────────────────────────────────────────────
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
.pnpm-debug.log*

# ────────────────────────────────────────────────
# 8. Test & coverage artefacts
# ────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
blob-report/
playwright/.cache/
.stryker-tmp/
stryker-tmp/
reports/

# ────────────────────────────────────────────────
# 9. Cache directories
# ────────────────────────────────────────────────
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
.prettiercache
*.tsbuildinfo
tsconfig.tsbuildinfo
.swc/

# ────────────────────────────────────────────────
# 10. Private root-level _* directories
#     (gitignored per AGENTS.md Hard Rules)
# ────────────────────────────────────────────────
/_*/
/_*

# ────────────────────────────────────────────────
# 11. OS junk
# ────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ────────────────────────────────────────────────
# 12. Editor / IDE
# ────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
.vim/
.editorconfig.local

# ────────────────────────────────────────────────
# 13. Misc generated / runtime files
# ────────────────────────────────────────────────
# Vercel deployment
.vercel/

# Fly.io / Docker volumes
.fly/

# Python byte-compiled (scripts in repo)
__pycache__/
*.py[cod]
*.pyo

# Temporary files
*.tmp
*.temp
*.bak
*.orig
*.rej

# Sourcemap files (generated at build time)
*.map

# Lock files — keep package-lock.json & pnpm-lock.yaml, ignore others
yarn.lock
shrinkwrap.json

# Certificate / key files (MITM proxy)
*.pem
*.crt
*.key
*.p12
*.pfx
certs/

# ────────────────────────────────────────────────
# 14. Stryker mutation testing
# ────────────────────────────────────────────────
.stryker-tmp/
reports/mutation/

# ────────────────────────────────────────────────
# 15. Promptfoo / eval artefacts
# ────────────────────────────────────────────────
promptfoo-output/
.promptfoo/

# ────────────────────────────────────────────────
# 16. Nix build
# ────────────────────────────────────────────────
result
result-*
